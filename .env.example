# ── Demo request form (src/app/api/demo/route.ts) ───────────────────────────
# Transactional email is sent via Resend (same provider as restaurant-backend).

# Required — Resend API key. Without it the form returns an error (never silently drops).
RESEND_API_KEY=

# From address. MUST be on the domain this Resend key is scoped to AND verified
# in Resend (muffinmenu.com). Resend verifies via its own DKIM selector + a
# return-path subdomain, so it coexists with Zoho mailboxes receiving mail.
DEMO_FROM="Muffin Menu <notifications@muffinmenu.com>"

# Where lead notifications land — the shared sales distribution list (Zoho).
DEMO_NOTIFY_TO=sales@muffinmenu.com

# Reply-To on the prospect's auto-reply (so their replies hit the shared inbox).
DEMO_REPLY_TO=sales@muffinmenu.com

# Optional — BCC the notification to a second address for redundancy.
DEMO_BCC=

# ── Spam protection (Cloudflare Turnstile) — optional until configured ───────
# When BOTH are set, the form renders the widget and the API verifies the token.
# When unset, only the honeypot + server-side validation apply.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
